# ── Game (Vite) ──────────────────────────────────────────────
VITE_ASSET_API_URL=http://127.0.0.1:8787

# ── FastAPI asset service ────────────────────────────────────
ASSET_API_HOST=127.0.0.1
ASSET_API_PORT=8787
ASSET_OUTPUT_DIR=public/assets/generated

# OpenAI Images (required for generation)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=high
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_BACKGROUND=transparent
